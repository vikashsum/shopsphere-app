pipeline {
     
     agent any
        
        stages {
            stage('checkout') {
                steps {
                    checkout scm
                }
            }
            stage('build') {
                steps {

                    echo "Installing dependencies"

                    sh 'pip3 install -r requirements.txt'

                }
            }
            stage('validate application') {
                steps {
                    sh 'python3 --version'

                    sh 'ls -la src'
                }
            }
        }
}